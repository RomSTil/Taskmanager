{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskman",
  "version": "0.1.0",
  "identifier": "dev.taskman.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Taskman",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://*; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "shortDescription": "Personal tasks and Markdown knowledge workspace",
    "category": "Productivity"
  }
}
