# Copy to .env. Never commit real secrets.
TASKMAN_DOMAIN=tasks.example.com
TASKMAN_ENVIRONMENT=production
TASKMAN_DATABASE_URL=postgresql+psycopg://taskman@db:5432/taskman
TASKMAN_VAULT_PATH=/data/vault
TASKMAN_PUBLIC_URL=https://tasks.example.com
TASKMAN_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
TASKMAN_JWT_SECRET=replace-with-at-least-32-random-characters
TASKMAN_ENCRYPTION_KEY=replace-with-a-fernet-key
TASKMAN_SETUP_TOKEN=replace-with-one-time-bootstrap-token
TASKMAN_MAX_ATTACHMENT_MB=25
TASKMAN_TELEGRAM_POLLING_ENABLED=false

POSTGRES_DB=taskman
POSTGRES_USER=taskman
POSTGRES_HOST_AUTH_METHOD=trust
BACKUP_RETENTION_DAYS=14
